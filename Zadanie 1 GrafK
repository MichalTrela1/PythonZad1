import cv2
import matplotlib.pyplot as plt

img = cv2.imread("obraz.jpg")
img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

plt.imshow(img_rgb)
plt.show()

h, w = img.shape[:2]
mniejszy = cv2.resize(img, (w // 2, h // 2))
szarosc = cv2.cvtColor(mniejszy, cv2.COLOR_BGR2GRAY)

wynik = cv2.rotate(szarosc, cv2.ROTATE_90_CLOCKWISE)

plt.imshow(wynik, cmap="gray")
plt.show()

print(wynik)
